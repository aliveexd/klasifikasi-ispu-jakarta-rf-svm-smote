    "tgl = np.sort(df.tanggal.unique())\n",
    "potong = tgl[int(len(tgl)*0.8)]\n",
    "latih = df[df.tanggal <  potong]\n",
    "uji   = df[df.tanggal >= potong]\n",
    "Xtr, ytr = latih[FITUR_NUM+FITUR_KAT], latih['target']\n",
    "Xte, yte = uji[FITUR_NUM+FITUR_KAT],  uji['target']\n",
    "\n",
    "KELAS_UJI = [k for k in KELAS if (yte == k).any()]     # kelas yang benar-benar ada di data uji\n",
    "HASIL['kelas_uji'] = KELAS_UJI\n",
    "HASIL['potong_tanggal'] = str(pd.Timestamp(potong).date())\n",
    "HASIL['n_latih'], HASIL['n_uji'] = len(latih), len(uji)\n",
    "HASIL['periode_latih'] = [str(latih.tanggal.min().date()), str(latih.tanggal.max().date())]\n",
    "HASIL['periode_uji']   = [str(uji.tanggal.min().date()),   str(uji.tanggal.max().date())]\n",
    "dist = pd.DataFrame({'latih':ytr.value_counts(), 'uji':yte.value_counts()}).reindex(KELAS).fillna(0).astype(int)\n",
    "HASIL['distribusi'] = dist.to_dict()\n",
    "HASIL['distribusi_total'] = df.target.value_counts().reindex(KELAS).to_dict()\n",
    "print('Latih:', HASIL['periode_latih'], '| Uji:', HASIL['periode_uji']); dist"
   ]
