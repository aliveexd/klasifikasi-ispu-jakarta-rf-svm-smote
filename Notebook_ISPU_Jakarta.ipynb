    "# 9b. Kesalahan menurut stasiun dan bulan (model terbaik)\n",
    "u = uji.copy(); u['prediksi'] = pred[terbaik]; u['salah'] = (u.prediksi != u.target)\n",
    "per_stasiun = (u.groupby('stasiun').salah.mean()*100).round(1)\n",
    "per_stasiun.index = [NAMA[i] for i in per_stasiun.index]\n",
    "per_bulan = (u.groupby(u.tanggal.dt.month).salah.mean()*100).round(1)\n",
    "HASIL['salah_per_stasiun'] = per_stasiun.to_dict()\n",
    "HASIL['salah_per_bulan'] = {int(k): v for k, v in per_bulan.items()}\n",
    "HASIL['uji_per_bulan_n'] = {int(k): int(v) for k, v in u.groupby(u.tanggal.dt.month).size().items()}\n",
    "HASIL['uji_distribusi_stasiun'] = {NAMA[k]: v for k, v in pd.crosstab(u.stasiun, u.target).to_dict('index').items()}\n",
    "print('Tingkat kesalahan per stasiun (%):'); print(per_stasiun); print('\\nPer bulan (%):'); print(per_bulan)"
   ]
