    "def bersih(o):\n",
    "    if isinstance(o, dict):  return {str(k): bersih(v) for k, v in o.items()}\n",
    "    if isinstance(o, (list, tuple)): return [bersih(v) for v in o]\n",
    "    if isinstance(o, (np.integer,)): return int(o)\n",
    "    if isinstance(o, (np.floating,)): return float(o)\n",
    "    return o\n",
    "with open('hasil_ispu.json', 'w', encoding='utf8') as f:\n",
    "    json.dump(bersih(HASIL), f, ensure_ascii=False, indent=2)\n",
    "print('Tersimpan: hasil_ispu.json, gambar1_confusion_matrix.png, gambar2_fitur_penting.png')\n",
    "if DI_COLAB:\n",
    "    for nm in ['hasil_ispu.json', 'gambar1_confusion_matrix.png', 'gambar2_fitur_penting.png']:\n",
    "        files.download(nm)"
   ]
