    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "A1 Random Forest | CV macro-F1 = 0.535 {'max_depth': None, 'min_samples_leaf': 1, 'n_estimators': 400}\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "A2 Random Forest + SMOTE | CV macro-F1 = 0.578 {'max_depth': 10, 'min_samples_leaf': 3, 'n_estimators': 400}\n"
     ]
    },
    {
     "name": "stdout",
