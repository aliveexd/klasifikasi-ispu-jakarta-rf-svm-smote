     "text": [
      "B2 SVM + SMOTE | CV macro-F1 = 0.558 {'C': 100, 'gamma': 0.01}\n"
     ]
    }
   ],
   "source": [
    "pra_rf  = ColumnTransformer([('num', SimpleImputer(strategy='median'), FITUR_NUM),\n",
    "                             ('kat', OneHotEncoder(handle_unknown='ignore'), FITUR_KAT)])\n",
    "pra_svm = ColumnTransformer([('num', Pipeline([('imp', SimpleImputer(strategy='median')), ('sc', MinMaxScaler())]), FITUR_NUM),\n",
    "                             ('kat', OneHotEncoder(handle_unknown='ignore'), FITUR_KAT)])\n",
    "\n",
    "def buat(algo, smote):\n",
    "    pra = pra_rf if algo == 'RF' else pra_svm\n",
    "    clf = RandomForestClassifier(random_state=SEED, n_jobs=-1) if algo == 'RF' else SVC(kernel='rbf', random_state=SEED)\n",
    "    langkah = [('pra', pra)] + ([('smote', SMOTE(k_neighbors=3, random_state=SEED))] if smote else []) + [('clf', clf)]\n",
    "    return ImbPipeline(langkah)\n",
    "\n",
    "GRID = {\n",
    "  'RF':  {'clf__n_estimators': [200, 400], 'clf__max_depth': [None, 10, 20], 'clf__min_samples_leaf': [1, 3]},\n",
    "  'SVM': {'clf__C': [0.1, 1, 10, 100], 'clf__gamma': ['scale', 0.01, 0.1]},\n",
    "}\n",
    "SKENARIO = {'A1':('RF',False,'Random Forest'), 'A2':('RF',True,'Random Forest + SMOTE'),\n",
    "            'B1':('SVM',False,'SVM'),          'B2':('SVM',True,'SVM + SMOTE')}\n",
    "cv = TimeSeriesSplit(n_splits=5)\n",
    "model, pred, param = {}, {}, {}\n",
    "for kode, (algo, sm, nama_s) in SKENARIO.items():\n",
    "    gs = GridSearchCV(buat(algo, sm), GRID[algo], cv=cv, scoring='f1_macro', n_jobs=-1)\n",
    "    gs.fit(Xtr, ytr)\n",
    "    model[kode], pred[kode] = gs.best_estimator_, gs.predict(Xte)\n",
    "    param[kode] = {k.replace('clf__',''): (v if v is None or isinstance(v,str) else (int(v) if float(v).is_integer() else float(v))) for k, v in gs.best_params_.items()}\n",
    "    print(kode, nama_s, '| CV macro-F1 = %.3f' % gs.best_score_, param[kode])\n",
    "HASIL['hiperparameter'] = param"
   ]
  },
